# API
API_HOST=0.0.0.0
API_PORT=8000
FRAUD_THRESHOLD=35.0
DOCSHIELD_API_KEY=your-secret-api-key-here

# CORS - restrict to your domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Risk Engine Weights (optional, defaults are set in code)
# WEIGHT_ELA=0.25
# WEIGHT_MOIRE=0.30
# WEIGHT_DCT=0.15
# WEIGHT_BLUR=0.10
# WEIGHT_OCR=0.10
# WEIGHT_REFLECTION=0.10

# MLflow
MLFLOW_TRACKING_URI=./mlruns

# Streamlit (solo entorno analista)
ANALYST_MODE=true
MAX_UPLOAD_SIZE_MB=5
